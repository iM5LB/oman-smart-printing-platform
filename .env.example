# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"

# Redis (optional for local workers)
REDIS_URL="redis://localhost:6379"

# API — on Render, PORT is set by the platform (API also accepts API_PORT locally)
API_PORT=4000
# Public URL of this API (signed file links, payment callbacks). Production: https://omsp-api.onrender.com
API_URL="https://omsp-api.onrender.com"
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="7d"

# Customer Web — point at online API by default. Use http://localhost:4000 only when running API locally.
NEXT_PUBLIC_API_URL="https://omsp-api.onrender.com"
NEXT_PUBLIC_APP_URL="https://omsp-web.onrender.com"
CORS_ORIGIN="https://omsp-web.onrender.com,https://omsp.onrender.com,http://localhost:3000,http://localhost:3001,http://localhost:1420"

# Local file storage (Render uses STORAGE_LOCAL_PATH on the API service)
STORAGE_LOCAL_PATH=""

# Payment (mock for development)
PAYMENT_PROVIDER="mock"

# OTP / notifications: mock | whatsapp (Meta Cloud API — see docs/whatsapp-otp.md)
# Business WhatsApp line (sender): +96876655365 — register this number in Meta WhatsApp Manager.
# WHATSAPP_PHONE_NUMBER_ID is Meta’s ID for that line, not the MSISDN. Customer OTPs still go to each customer.
SMS_PROVIDER="mock"
# WHATSAPP_BUSINESS_NUMBER="+96876655365"
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_OTP_TEMPLATE_NAME="otp_verify"
# WHATSAPP_OTP_TEMPLATE_LANG="ar"
# WHATSAPP_ORDER_READY_TEMPLATE_NAME=""
# WHATSAPP_OTP_SKIP_COPY_BUTTON="false"

# File settings
MAX_FILE_SIZE_BYTES=52428800
SIGNED_URL_TTL_SECONDS=300

# Environment
NODE_ENV="development"

# Admin password to unlock first-time library onboarding (keep secret)
LIBRARY_SETUP_PASSWORD="change-me-setup-password"
