# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"

# Redis (optional for local workers)
REDIS_URL="redis://localhost:6379"

# API — on Render, PORT is set by the platform (API also accepts API_PORT locally)
API_PORT=4000
API_URL="http://localhost:4000"
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="7d"

# Customer Web
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Local file storage (Render uses STORAGE_LOCAL_PATH on the API service)
STORAGE_LOCAL_PATH=""

# Payment (mock for development)
PAYMENT_PROVIDER="mock"

# SMS (mock for development)
SMS_PROVIDER="mock"

# File settings
MAX_FILE_SIZE_BYTES=52428800
SIGNED_URL_TTL_SECONDS=300

# Environment
NODE_ENV="development"
