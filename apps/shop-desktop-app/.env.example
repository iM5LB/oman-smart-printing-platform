# Optional DEV override only (`tauri:dev` / Vite).
# Release builds always use https://omsp-api.onrender.com (no UI setting).
VITE_API_URL=http://localhost:4000

# Customer web origin for shop links / QR (optional).
# Defaults to http://localhost:3000 in DEV, https://omsp.onrender.com in release.
VITE_WEB_URL=http://localhost:3000
