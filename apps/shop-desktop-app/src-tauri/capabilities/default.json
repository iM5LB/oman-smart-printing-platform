{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "process:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://omsp-api.onrender.com/**" },
        { "url": "http://localhost:4000/**" },
        { "url": "http://127.0.0.1:4000/**" }
      ]
    }
  ]
}
