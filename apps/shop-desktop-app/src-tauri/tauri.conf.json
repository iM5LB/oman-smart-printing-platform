{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tibaa",
  "mainBinaryName": "Tibaa",
  "version": "0.1.0",
  "identifier": "om.smartprint.shopdesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "طباعة — المكتبة",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "publisher": "Tibaa",
    "copyright": "Copyright © Tibaa",
    "category": "Business",
    "shortDescription": "Tibaa library desktop",
    "longDescription": "Tibaa — smart printing and document services for libraries.",
    "resources": {
      "binaries/print-worker.exe": "print-worker.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "Tibaa"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwOEM1MjhDRDY2RDcwNkIKUldScmNHM1dqRktNY081ZGZQd1hFNGVOYzJ0czFib29Vd2J4Q01xNnFCaERraHZDRWdtZzhRZUwK",
      "endpoints": [
        "https://github.com/iM5LB/oman-smart-printing-platform/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
