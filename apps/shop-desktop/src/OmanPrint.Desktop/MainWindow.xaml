                        <!-- Prices -->
                        <StackPanel x:Name="PagePrices" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="تحديث" Style="{StaticResource BtnOutline}" Click="RefreshPricing_Click" Padding="14,8"/>
                            </StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="أسعار الطباعة (بيسة / صفحة)" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl x:Name="PricingRulesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding PriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource InputBox}" Margin="8,0"/>
                                                    <Button Grid.Column="2" Content="حفظ" Style="{StaticResource BtnOutline}" Padding="12,8"
                                                            Tag="{Binding Id}" Click="SavePriceRule_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="خدمات التجهيز" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl x:Name="FinishingList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding NameAr}" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding PriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource InputBox}" Margin="8,0"/>
                                                    <Button Grid.Column="2" Content="حفظ" Style="{StaticResource BtnOutline}" Padding="12,8"
                                                            Tag="{Binding Id}" Click="SaveFinishing_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Reports -->
                        <StackPanel x:Name="PageReports" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="تحديث" Style="{StaticResource BtnOutline}" Click="RefreshReports_Click" Padding="14,8"/>
                            </StackPanel>
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <Border Style="{StaticResource StatCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="طلبات هذا الأسبوع" Style="{StaticResource LabelText}" Margin="0"/>
                                        <TextBlock x:Name="ReportWeekOrders" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatCard}" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="إيرادات الأسبوع" Style="{StaticResource LabelText}" Margin="0"/>
                                        <TextBlock x:Name="ReportWeekRevenue" Text="0.000 ر.ع" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource StatCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="طلبات اليوم" Style="{StaticResource LabelText}" Margin="0"/>
                                        <TextBlock x:Name="ReportTodayOrders" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatCard}" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="إيرادات اليوم" Style="{StaticResource LabelText}" Margin="0"/>
                                        <TextBlock x:Name="ReportTodayRevenue" Text="0.000 ر.ع" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Settings -->
                        <StackPanel x:Name="PageSettings" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" MaxWidth="560" HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Text="الاتصال بالخادم" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="رابط API" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="ApiUrlBox" Style="{StaticResource InputBox}" Margin="0,0,0,12"/>
                                    <TextBlock Text="رمز الجهاز" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="DeviceTokenBox" Style="{StaticResource InputBox}" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="AutoConnectCheck" Content="اتصال تلقائي عند فتح التطبيق" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>
                                    <Button Content="حفظ الإعدادات" Style="{StaticResource BtnPrimary}" Click="SaveSettings_Click" HorizontalAlignment="Right" Width="140"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" MaxWidth="560">
                                <StackPanel>
                                    <TextBlock Text="تسجيل جهاز جديد" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="معرّف المكتبة" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="RegisterStoreSlug" Style="{StaticResource InputBox}" Margin="0,0,0,12"/>
                                    <TextBlock Text="اسم الجهاز" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="RegisterDeviceName" Style="{StaticResource InputBox}" Margin="0,0,0,12"/>
                                    <Button Content="تسجيل والحصول على رمز" Style="{StaticResource BtnOutline}" Click="RegisterDevice_Click" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="RegisterResult" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" MaxWidth="560">
                                <StackPanel>
                                    <TextBlock Text="سجل النشاط" Style="{StaticResource SectionTitle}"/>
                                    <Border Background="#152032" CornerRadius="8" Padding="10">
                                        <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                                 Background="Transparent" FontSize="11" Foreground="{StaticResource MutedBrush}" MaxHeight="180"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Detail sidebar (left in RTL) -->
            <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,20">
                    <StackPanel>
                        <TextBlock Text="تفاصيل الطلب" FontSize="14" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <TextBlock x:Name="DetailOrderNumber" Text="—" FontSize="26" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="DetailEmptyHint" Text="اختر طلباً من القائمة لعرض التفاصيل والإجراءات" TextWrapping="Wrap"
                                   Foreground="#64748B" FontSize="14" Margin="0,12,0,0" LineHeight="22"/>

                        <StackPanel x:Name="DetailContent" Visibility="Collapsed" Margin="0,16,0,0">
                            <!-- Customer -->
                            <Border Background="#1E293B" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <Border DockPanel.Dock="Right" Background="#1E3A5F" CornerRadius="22" Width="44" Height="44" Margin="0,0,12,0">
                                            <TextBlock x:Name="DetailAvatarLetter" Text="ع" Foreground="#BFDBFE" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="DetailCustomerName" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock x:Name="DetailCustomerPhone" FontSize="14" Foreground="#94A3B8" Margin="0,5,0,0"
                                                       FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Border x:Name="DetailPaymentBadge" Background="#166534" CornerRadius="999" Padding="12,6"
                                            HorizontalAlignment="Right" Margin="0,0,0,12">
                                        <TextBlock x:Name="DetailPaymentStatus" Text="مدفوع" FontSize="13" FontWeight="SemiBold" Foreground="#BBF7D0"/>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="طريقة الدفع" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="DetailPaymentMethod" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="وقت الطلب" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="DetailCreatedAt" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Specs -->
                            <Border Background="#1E293B" CornerRadius="14" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="مواصفات الطلب" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>

                                    <Border Background="#152033" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="الملف" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="DetailFilename" FontSize="14" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" LineHeight="22"/>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#152033" CornerRadius="10" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="الصفحات" FontSize="12" Foreground="#64748B" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="DetailPages" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="#152033" CornerRadius="10" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="النسخ" FontSize="12" Foreground="#64748B" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="DetailCopies" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#152033" CornerRadius="10" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="اللون" FontSize="12" Foreground="#64748B" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="DetailColor" FontSize="15" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="#152033" CornerRadius="10" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="الورق" FontSize="12" Foreground="#64748B" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="DetailPaper" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Background="#152033" CornerRadius="10" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="الطباعة" FontSize="12" Foreground="#64748B" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="DetailDuplex" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Timeline -->
                            <Border Background="#1E293B" CornerRadius="14" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="مسار الطلب" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <ItemsControl x:Name="DetailTimeline">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{Binding TextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Total -->
                            <Border Background="#1E293B" CornerRadius="14" Padding="16" Margin="0,0,0,16">
                                <DockPanel>
                                    <TextBlock Text="السعر الإجمالي" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DetailTotal" DockPanel.Dock="Left" FontSize="24" FontWeight="Bold"
                                               Foreground="#3B82F6" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <Button x:Name="DetailPrintBtn" Content="طباعة" Style="{StaticResource BtnPrimary}" Click="DetailPrint_Click" Margin="0,0,0,10" Padding="0,14" FontSize="15"/>
                            <Button x:Name="DetailRetryBtn" Content="إعادة المحاولة" Style="{StaticResource BtnOutline}" Click="DetailRetry_Click" Margin="0,0,0,10" FontSize="14" Visibility="Collapsed"/>
                            <Button x:Name="DetailPayBtn" Content="تحصيل الدفع (نقداً)" Style="{StaticResource BtnOutline}" Click="DetailPay_Click" Margin="0,0,0,10" Visibility="Collapsed" FontSize="14"/>
                            <Button x:Name="DetailReadyBtn" Content="جاهز للاستلام" Style="{StaticResource BtnSuccess}" Click="DetailReady_Click" Margin="0,0,0,10" Padding="0,14" FontSize="15" Visibility="Collapsed"/>
                            <Button x:Name="DetailCollectedBtn" Content="تم التسليم" Style="{StaticResource BtnOutline}" Click="DetailCollected_Click" FontSize="14" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource StatusBar}">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusBarDot" Width="6" Height="6" Fill="{StaticResource ErrorBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnectionStatusBarText" Text="غير متصل" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="SyncFooterText" Text="آخر مزامنة: —" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Left" Text="الإصدار 1.0.0" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
