<Window x:Class="OmanPrint.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="منصة الطباعة — لوحة التحكم"
        Height="720" Width="1100" MinHeight="560" MinWidth="900"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        Background="{StaticResource BgAppBrush}"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Border x:Name="PrintConfirmOverlay" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="110">
            <Border Style="{StaticResource Card}" Width="480" MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                <StackPanel>
                    <TextBlock Text="تأكيد الطباعة" Style="{StaticResource PageTitle}" FontSize="22" Margin="0,0,0,16"/>
                    <Border Background="#152033" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="رقم الطلب" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="ConfirmOrderNumber" Grid.Column="1" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="1" Text="العميل" Style="{StaticResource MetricLabel}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="ConfirmCustomer" Grid.Row="1" Grid.Column="1" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="2" Text="الملف" Style="{StaticResource MetricLabel}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="ConfirmFile" Grid.Row="2" Grid.Column="1" FontSize="14" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="3" Text="الصفحات" Style="{StaticResource MetricLabel}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="ConfirmPages" Grid.Row="3" Grid.Column="1" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="4" Text="النسخ" Style="{StaticResource MetricLabel}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="ConfirmCopies" Grid.Row="4" Grid.Column="1" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="5" Text="اللون" Style="{StaticResource MetricLabel}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="ConfirmColor" Grid.Row="5" Grid.Column="1" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="6" Text="الورق" Style="{StaticResource MetricLabel}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="ConfirmPaper" Grid.Row="6" Grid.Column="1" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="7" Text="الطباعة" Style="{StaticResource MetricLabel}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="ConfirmDuplex" Grid.Row="7" Grid.Column="1" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="8" Text="الإجمالي" Style="{StaticResource MetricLabel}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="ConfirmTotal" Grid.Row="8" Grid.Column="1" FontSize="15" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,0">
                        <Button Content="إلغاء" Style="{StaticResource BtnOutline}" Click="PrintConfirmCancel_Click" Padding="20,10" Margin="0,0,8,0"/>
                        <Button Content="تأكيد الطباعة" Style="{StaticResource BtnPrimary}" Click="ConfirmPrint_Click" Padding="20,10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border x:Name="SetupOverlay" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Style="{StaticResource Card}" Width="480" MaxWidth="540" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                <StackPanel>
                    <TextBlock Text="ربط جهاز المكتبة" Style="{StaticResource PageTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="هذا التطبيق أداة تشغيل فقط. إعداد المكتبة والموقع ورقم التأكيد من لوحة الويب. هنا تربط الجهاز بكلمة المرور ورمز SMS أو برمز صادر من اللوحة."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" FontSize="13"/>

                    <TextBlock Text="رابط الخادم" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="SetupApiUrl" Style="{StaticResource InputBox}" Text="https://omsp-api.onrender.com" Margin="0,0,0,10"/>
                    <TextBlock Text="معرّف المكتبة" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="SetupStoreSlug" Style="{StaticResource InputBox}" Text="al-noor" Margin="0,0,0,10"/>
                    <TextBlock Text="اسم الجهاز" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="SetupDeviceName" Style="{StaticResource InputBox}" Text="جهاز الكاونتر" Margin="0,0,0,10"/>

                    <CheckBox x:Name="SetupUseExistingToken" Content="لدي رمز جهاز جاهز من لوحة المكتبة"
                              IsChecked="False" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"
                              Checked="SetupMode_Changed" Unchecked="SetupMode_Changed"/>

                    <StackPanel x:Name="SetupTokenPanel" Visibility="Collapsed">
                        <TextBlock Text="رمز الجهاز" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="SetupDeviceToken" Style="{StaticResource InputBox}" Margin="0,0,0,12"
                                 Text="dev-al-noor-device-token-change-in-production"/>
                        <Button Content="ربط والبدء" Style="{StaticResource BtnPrimary}" Click="SetupSave_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="SetupPairPanel">
                        <TextBlock Text="كلمة مرور الجهاز (من لوحة المكتبة)" Style="{StaticResource LabelText}"/>
                        <PasswordBox x:Name="SetupDevicePassword" Margin="0,0,0,10" Height="36" Padding="10,6"
                                     Background="{StaticResource BgInputBrush}" Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                     Password="device123"/>
                        <StackPanel x:Name="SetupOtpPanel" Visibility="Collapsed" Margin="0,0,0,10">
                            <TextBlock x:Name="SetupOtpHint" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Text="رمز التأكيد" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="SetupOtpCode" Style="{StaticResource InputBox}" Margin="0,0,0,8"/>
                            <Button Content="تأكيد الربط" Style="{StaticResource BtnPrimary}" Click="SetupConfirmPair_Click"/>
                        </StackPanel>
                        <Button x:Name="SetupStartPairBtn" Content="إرسال رمز التأكيد" Style="{StaticResource BtnPrimary}"
                                Click="SetupStartPair_Click" Margin="0,0,0,4"/>
                    </StackPanel>

                    <TextBlock x:Name="SetupError" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <Border x:Name="OfflineBanner" Grid.Row="0" Style="{StaticResource OfflineBanner}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FCD34D"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="غير متصل بالإنترنت — سيستمر تنفيذ مهام الطباعة المحمّلة مسبقاً."
                               Foreground="#FDE68A" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DetailColumn" Width="340" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Padding="14,18">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource PrimaryDarkBrush}" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="منصة الطباعة" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="سلطنة عُمان" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Border Background="#152033" CornerRadius="12" Padding="10" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource PrimaryDarkBrush}" CornerRadius="18" Width="36" Height="36" Margin="0,0,10,0">
                                        <TextBlock x:Name="UserAvatarLetter" Text="م" Foreground="White" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="UserNameText" Text="موظف الطباعة" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock x:Name="UserRoleText" Text="موظف طباعة" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"/>
                                        <TextBlock x:Name="StoreNameText" Text="غير متصل" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource ErrorBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ConnectionStatus" Text="غير متصل" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="ConnectBtn" Content="اتصال" Style="{StaticResource BtnOutline}" Click="ConnectBtn_Click"
                                    Padding="8,7" FontSize="12" HorizontalAlignment="Stretch"/>
                            <TextBlock x:Name="AppVersionNavText" Text="الإصدار 1.0.0" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4,0,0">
                            <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="الرئيسية" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavOrders" Style="{StaticResource NavItem}" GroupName="Nav">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8CB;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="الطلبات" VerticalAlignment="Center"/>
                                    <Border x:Name="OrdersBadge" Background="{StaticResource WarningBrush}" CornerRadius="10" Padding="6,1" Margin="6,0,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="OrdersBadgeText" Text="0" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavPrintQueue" Style="{StaticResource NavItem}" GroupName="Nav">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE823;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="قائمة الطباعة" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavPrinters" Style="{StaticResource NavItem}" GroupName="Nav">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE749;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="الطابعات" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavPayments" Style="{StaticResource NavItem}" GroupName="Nav">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C7;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="المدفوعات" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavCustomers" Style="{StaticResource NavItem}" GroupName="Nav">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE716;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="العملاء" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavPrices" Style="{StaticResource NavItem}" GroupName="Nav">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F2;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="الأسعار والخدمات" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavReports" Style="{StaticResource NavItem}" GroupName="Nav">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D2;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="التقارير" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavPickup" Style="{StaticResource NavItem}" GroupName="Nav">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="الاستلام" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavEmployees" Style="{StaticResource NavItem}" GroupName="Nav">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77B;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="الموظفون" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavNotifications" Style="{StaticResource NavItem}" GroupName="Nav">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7EA;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="الإشعارات" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavAudit" Style="{StaticResource NavItem}" GroupName="Nav">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="سجل العمليات" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="الإعدادات" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Main -->
            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Style="{StaticResource TopBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitleText" Text="لوحة التحكم" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="WelcomeText" Text="مرحباً، إليك نظرة عامة على عمليات اليوم" FontSize="12.5"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="280" Margin="0,0,12,0">
                                <TextBox x:Name="GlobalSearchBox" Style="{StaticResource SearchBox}"
                                         TextChanged="GlobalSearchBox_TextChanged" KeyDown="GlobalSearchBox_KeyDown"/>
                                <TextBlock x:Name="GlobalSearchHint" Text="ابحث برقم الطلب، الاسم أو رقم الهاتف..." IsHitTestVisible="False"
                                           Foreground="#64748B" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="ClockText" Text="—" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource BtnOutline}"
                                    Click="RefreshOrders_Click" Padding="8,6" FontSize="13" ToolTip="تحديث"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14">
                    <StackPanel>
                        <Grid MinWidth="0">
                        <!-- Dashboard -->
                        <StackPanel x:Name="PageDashboard" Visibility="Visible">
                            <Grid Margin="0,0,0,4">
                                <Border x:Name="ToastBanner" Style="{StaticResource ToastCard}" Margin="0,0,0,12"
                                        Visibility="Collapsed" HorizontalAlignment="Left" Panel.ZIndex="20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#22C55E" Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="ToastTitle" Text="طلب جديد" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock x:Name="ToastSubtitle" Text="تم استلام طلب جديد من العميل" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                Style="{StaticResource LinkButton}" Foreground="#64748B" FontSize="12"
                                                Click="ToastClose_Click" VerticalAlignment="Top" Padding="4"/>
                                    </Grid>
                                </Border>
                                <!-- Keep ToastText for code-behind compatibility (hidden) -->
                                <TextBlock x:Name="ToastText" Visibility="Collapsed"/>
                            </Grid>

                            <UniformGrid Columns="4" Margin="0,0,0,16">
                                <Border Style="{StaticResource StatCard}" Margin="0,0,8,0">
                                    <Grid>
                                        <Border Width="40" Height="40" CornerRadius="20" Background="#1E3A5F"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#60A5FA"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="0,48,0,0">
                                            <TextBlock Text="طلبات اليوم" Style="{StaticResource MetricLabel}" Margin="0"/>
                                            <TextBlock x:Name="StatTodayOrders" Text="0" FontSize="26" FontWeight="Bold"
                                                       Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="StatOrdersDelta" Text="" FontSize="12"
                                                       Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource StatCard}" Margin="4,0">
                                    <Grid>
                                        <Border Width="40" Height="40" CornerRadius="20" Background="#14532D"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#4ADE80"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="0,48,0,0">
                                            <TextBlock Text="الإيرادات اليوم" Style="{StaticResource MetricLabel}" Margin="0"/>
                                            <TextBlock x:Name="StatTodayRevenue" Text="0.000 ر.ع" FontSize="20" FontWeight="Bold"
                                                       Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="StatRevenueDelta" Text="" FontSize="12"
                                                       Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource StatCard}" Margin="4,0">
                                    <Grid>
                                        <Border Width="40" Height="40" CornerRadius="20" Background="#3B1D6E"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#C4B5FD"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="0,48,0,0">
                                            <TextBlock Text="قيد الطباعة" Style="{StaticResource MetricLabel}" Margin="0"/>
                                            <TextBlock x:Name="StatPrinting" Text="0" FontSize="26" FontWeight="Bold"
                                                       Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="الطلبات الجارية الآن" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource StatCard}" Margin="8,0,0,0">
                                    <Grid>
                                        <Border Width="40" Height="40" CornerRadius="20" Background="#7C2D12"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FDBA74"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="0,48,0,0">
                                            <TextBlock Text="جاهزة للاستلام" Style="{StaticResource MetricLabel}" Margin="0"/>
                                            <TextBlock x:Name="StatReady" Text="0" FontSize="26" FontWeight="Bold"
                                                       Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="جاهزة في المكتبة" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="0">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="18,16,18,10" LastChildFill="False">
                                        <TextBlock Text="الطلبات المباشرة" Style="{StaticResource SectionTitle}" Margin="0"
                                                   VerticalAlignment="Center" FontSize="16"/>
                                        <Button DockPanel.Dock="Left" Content="عرض الكل" Style="{StaticResource LinkButton}"
                                                Click="ViewAllOrders_Click" Margin="12,0,0,0" VerticalAlignment="Center"
                                                FontSize="13.5" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <DataGrid x:Name="LiveOrdersGrid" Style="{StaticResource DarkDataGrid}" MaxHeight="300"
                                              VerticalScrollBarVisibility="Auto" RowHeight="48"
                                              SelectionChanged="LiveOrdersGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="رقم الطلب" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding OrderNumberShort}" FontSize="13.5" FontWeight="SemiBold"
                                                                   Foreground="#60A5FA" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="اسم العميل" Binding="{Binding CustomerName}" Width="*"/>
                                            <DataGridTemplateColumn Header="الهاتف" Width="130">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding CustomerPhone}" FlowDirection="LeftToRight"
                                                                   FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="الخدمة" Binding="{Binding ServiceTypeLabel}" Width="120"/>
                                            <DataGridTemplateColumn Header="الحالة" Width="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding StatusBg}" CornerRadius="999" Padding="10,5"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding StatusIcon}" FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="11" Foreground="{Binding StatusFg}"
                                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding StatusAr}" FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{Binding StatusFg}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="وقت الطلب" Binding="{Binding TimeLabel}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="NoRecentOrders" Text="لا توجد طلبات حالياً" Foreground="{StaticResource MutedBrush}"
                                               TextAlignment="Center" Margin="0,24" FontSize="13"/>
                                </DockPanel>
                            </Border>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Print queue (screen right in RTL = column 0) -->
                                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12" LastChildFill="False">
