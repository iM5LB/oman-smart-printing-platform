                                    <Button x:Name="QueueOpenCurrentBtn" Content="فتح الطلب" Style="{StaticResource LinkButton}"
                                            Click="QueueOpenCurrent_Click" HorizontalAlignment="Right" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="التالي" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="0,8">
                                <StackPanel>
                                    <ItemsControl x:Name="QueueWaitingList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
