                                        <Border Style="{StaticResource FilterChipBadge}"><TextBlock x:Name="FilterCompletedCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/></Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="FilterCancelled" Style="{StaticResource FilterChip}" GroupName="OrdersStatusFilter"
                                             Tag="cancelled" Checked="OrdersFilter_Checked">
