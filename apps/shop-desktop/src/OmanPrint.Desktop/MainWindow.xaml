                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{Binding StatusBg}" CornerRadius="6" Padding="8,3" Margin="8,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusAr}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusFg}"/>
                                                        </Border>
                                                        <Button Grid.Column="2" Content="فتح" Style="{StaticResource BtnOutline}" Padding="10,5" FontSize="12"
