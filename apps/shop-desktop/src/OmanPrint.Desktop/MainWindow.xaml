                                            </Border>
                                        </DockPanel>

                                        <Border Background="#121A2A" BorderBrush="#243044" BorderThickness="1"
                                                CornerRadius="12" Padding="14" Margin="0,0,0,16">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="QueueFileBadge" Width="40" Height="44" CornerRadius="6"
                                                            Background="#DC2626" Margin="0,0,12,0" VerticalAlignment="Top">
                                                        <TextBlock x:Name="QueueFileExt" Text="PDF" FontSize="10" FontWeight="Bold"
                                                                   Foreground="White" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock x:Name="QueueCurrentJob" Text="لا توجد مهمة نشطة" FontSize="14"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock x:Name="QueueCurrentMeta" Text="" FontSize="12"
                                                                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar x:Name="QueueProgress" Height="8" Minimum="0" Maximum="100" Value="0"
                                                                 Foreground="#3B82F6" Background="#0F172A"
                                                                 VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="QueueProgressPct" Grid.Column="1" Text="0%" FontSize="12"
                                                               FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="التالي في الطابور" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                                        <ItemsControl x:Name="QueueUpcomingList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#121A2A" BorderBrush="#243044" BorderThickness="1"
                                                            CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="36" Height="40" CornerRadius="6"
                                                                    Background="{Binding ExtBrush}" Margin="0,0,10,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ExtLabel}" FontSize="9" FontWeight="Bold"
                                                                           Foreground="White" HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Filename}" FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding MetaLine}" FontSize="11.5"
                                                                           Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                <TextBlock Text="في الانتظار" FontSize="11.5"
                                                                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left"/>
                                                                <TextBlock Text="{Binding PagesLabel}" FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"
                                                                           HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="NoUpcomingQueue" Text="لا توجد مهام في الانتظار"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="13"
                                                   TextAlignment="Center" Margin="0,4" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Printer status (screen left in RTL = column 2) -->
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,14" LastChildFill="False">
                                            <TextBlock Text="حالة الطابعات" Style="{StaticResource SectionTitle}" Margin="0"
                                                       VerticalAlignment="Center" FontSize="15"/>
                                            <Button DockPanel.Dock="Left" Content="إدارة الطابعات" Style="{StaticResource LinkButton}"
                                                    Click="ViewPrinters_Click" VerticalAlignment="Center"
                                                    FontSize="13" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <ItemsControl x:Name="DashboardPrintersList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#121A2A" BorderBrush="#243044" BorderThickness="1"
                                                            CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="48" Height="48" CornerRadius="10" Background="#1A2438"
                                                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                                           Foreground="#94A3B8" HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}"
                                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="{Binding StatusAr}" FontSize="12"
                                                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="قائمة الانتظار" FontSize="11"
                                                                           Foreground="{StaticResource MutedBrush}"
                                                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                <Border Style="{StaticResource QueueCountBox}">
                                                                    <TextBlock Text="{Binding QueueCount}" FontSize="15" FontWeight="Bold"
                                                                               Foreground="{StaticResource TextBrush}"
                                                                               HorizontalAlignment="Center"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="NoDashboardPrinters" Text="لا توجد طابعات مكتشفة"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="13"
                                                   TextAlignment="Center" Margin="0,8" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Pickup -->
                        <StackPanel x:Name="PagePickup" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}" MaxWidth="520" HorizontalAlignment="Center" Margin="0,24,0,0" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="وضع الاستلام" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="أدخل رقم الطلب" FontSize="14" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,20"/>
                                    <TextBox x:Name="PickupSearchBox" Style="{StaticResource InputBox}" FontSize="28" TextAlignment="Center"
                                             FlowDirection="LeftToRight" Padding="14,12" Margin="0,0,0,12" KeyDown="PickupSearchBox_KeyDown"/>
                                    <Button Content="بحث" Style="{StaticResource BtnPrimary}" Click="PickupSearch_Click" HorizontalAlignment="Stretch" Padding="0,12" FontSize="15"/>
                                    <StackPanel x:Name="PickupResultPanel" Visibility="Collapsed" Margin="0,20,0,0">
                                        <Border Background="#152033" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="رقم الطلب" Style="{StaticResource MetricLabel}"/>
                                                <TextBlock x:Name="PickupOrderNumber" Grid.Column="1" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Grid.Row="1" Text="العميل" Style="{StaticResource MetricLabel}" Margin="0,8,0,0"/>
                                                <TextBlock x:Name="PickupCustomerName" Grid.Row="1" Grid.Column="1" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                                                <TextBlock Grid.Row="2" Text="الهاتف" Style="{StaticResource MetricLabel}" Margin="0,8,0,0"/>
                                                <TextBlock x:Name="PickupCustomerPhone" Grid.Row="2" Grid.Column="1" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" FlowDirection="LeftToRight"/>
                                                <TextBlock Grid.Row="3" Text="المبلغ" Style="{StaticResource MetricLabel}" Margin="0,8,0,0"/>
                                                <TextBlock x:Name="PickupAmount" Grid.Row="3" Grid.Column="1" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0"/>
                                                <TextBlock Grid.Row="4" Text="الحالة" Style="{StaticResource MetricLabel}" Margin="0,8,0,0"/>
                                                <TextBlock x:Name="PickupStatus" Grid.Row="4" Grid.Column="1" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                                                <TextBlock Grid.Row="5" Text="الدفع" Style="{StaticResource MetricLabel}" Margin="0,8,0,0"/>
                                                <TextBlock x:Name="PickupPayment" Grid.Row="5" Grid.Column="1" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                                            </Grid>
                                        </Border>
                                        <Button x:Name="PickupPayBtn" Content="تسجيل الدفع" Style="{StaticResource BtnOutline}" Click="PickupPay_Click"
                                                Margin="0,0,0,8" Visibility="Collapsed" Padding="0,12"/>
                                        <Button x:Name="PickupCollectBtn" Content="تم التسليم" Style="{StaticResource BtnSuccess}" Click="PickupCollect_Click" Padding="0,12"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PickupEmptyHint" Text="أدخل رقم الطلب واضغط بحث للعثور على الطلب"
                                               Foreground="{StaticResource MutedBrush}" FontSize="13" TextAlignment="Center" Margin="0,20,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Employees stub -->
                        <StackPanel x:Name="PageEmployees" Visibility="Collapsed">
                            <Border Style="{StaticResource EmptyState}" MaxWidth="480" HorizontalAlignment="Center" Margin="0,40,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="إدارة الموظفين" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextAlignment="Center" Margin="0,12,0,0"/>
                                    <TextBlock Text="ستتمكن قريباً من إدارة صلاحيات الموظفين وجداول العمل من هذه الشاشة."
                                               FontSize="13" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="360"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Notifications stub -->
                        <StackPanel x:Name="PageNotifications" Visibility="Collapsed">
                            <Border Style="{StaticResource EmptyState}" MaxWidth="480" HorizontalAlignment="Center" Margin="0,40,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE7EA;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="الإشعارات" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextAlignment="Center" Margin="0,12,0,0"/>
                                    <TextBlock Text="ستظهر هنا تنبيهات الطلبات الجديدة وتذكيرات الاستلام والتنبيهات التشغيلية."
                                               FontSize="13" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="360"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Audit stub -->
                        <StackPanel x:Name="PageAudit" Visibility="Collapsed">
                            <Border Style="{StaticResource EmptyState}" MaxWidth="480" HorizontalAlignment="Center" Margin="0,40,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="سجل العمليات" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextAlignment="Center" Margin="0,12,0,0"/>
                                    <TextBlock Text="سيتم عرض سجل كامل لعمليات الدفع والطباعة والتسليم لأغراض المراجعة والتدقيق."
                                               FontSize="13" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="360"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Orders -->
                        <StackPanel x:Name="PageOrders" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,12" LastChildFill="False">
                                <Button DockPanel.Dock="Right" Content="تحديث" Style="{StaticResource BtnOutline}"
                                        Click="RefreshOrders_Click" Padding="14,8"/>
                                <TextBlock Text="اضغط على صف لفتح التفاصيل والإجراءات" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            </DockPanel>
                            <WrapPanel Margin="0,0,0,12">
                                <RadioButton x:Name="FilterAll" Style="{StaticResource FilterChip}" GroupName="OrdersStatusFilter"
                                             Tag="" IsChecked="True" Checked="OrdersFilter_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="الكل" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource FilterChipBadge}"><TextBlock x:Name="FilterAllCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/></Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="FilterNew" Style="{StaticResource FilterChip}" GroupName="OrdersStatusFilter"
                                             Tag="new" Checked="OrdersFilter_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="جديدة" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource FilterChipBadge}"><TextBlock x:Name="FilterNewCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/></Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="FilterReview" Style="{StaticResource FilterChip}" GroupName="OrdersStatusFilter"
                                             Tag="review" Checked="OrdersFilter_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="تحتاج مراجعة" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource FilterChipBadge}"><TextBlock x:Name="FilterReviewCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/></Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="FilterQueued" Style="{StaticResource FilterChip}" GroupName="OrdersStatusFilter"
                                             Tag="queued" Checked="OrdersFilter_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="بانتظار الطباعة" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource FilterChipBadge}"><TextBlock x:Name="FilterQueuedCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/></Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="FilterPrinting" Style="{StaticResource FilterChip}" GroupName="OrdersStatusFilter"
                                             Tag="printing" Checked="OrdersFilter_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="جاري الطباعة" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource FilterChipBadge}"><TextBlock x:Name="FilterPrintingCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/></Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="FilterPreparing" Style="{StaticResource FilterChip}" GroupName="OrdersStatusFilter"
                                             Tag="preparing" Checked="OrdersFilter_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="بانتظار التجهيز" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource FilterChipBadge}"><TextBlock x:Name="FilterPreparingCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/></Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="FilterReady" Style="{StaticResource FilterChip}" GroupName="OrdersStatusFilter"
                                             Tag="ready" Checked="OrdersFilter_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="جاهزة للاستلام" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource FilterChipBadge}"><TextBlock x:Name="FilterReadyCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/></Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="FilterCompleted" Style="{StaticResource FilterChip}" GroupName="OrdersStatusFilter"
                                             Tag="completed" Checked="OrdersFilter_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="مكتملة" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource FilterChipBadge}"><TextBlock x:Name="FilterCompletedCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/></Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="FilterCancelled" Style="{StaticResource FilterChip}" GroupName="OrdersStatusFilter"
                                             Tag="cancelled" Checked="OrdersFilter_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ملغية" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource FilterChipBadge}"><TextBlock x:Name="FilterCancelledCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/></Border>
                                    </StackPanel>
                                </RadioButton>
                            </WrapPanel>
                            <Border Style="{StaticResource Card}" Padding="0">
                                <DataGrid x:Name="OrdersGrid" Style="{StaticResource DarkDataGrid}" MinHeight="320"
                                          SelectionChanged="OrdersGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="رقم الطلب" Binding="{Binding OrderNumberShort}" Width="80"/>
                                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/>
                                        <DataGridTemplateColumn Header="الهاتف" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CustomerPhone}" FlowDirection="LeftToRight" FontSize="13"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="الخدمة" Binding="{Binding ServiceTypeLabel}" Width="100"/>
                                        <DataGridTextColumn Header="الدفع" Binding="{Binding PaymentLabel}" Width="90"/>
                                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="110"/>
                                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalDisplay}" Width="90"/>
                                        <DataGridTextColumn Header="الوقت" Binding="{Binding TimeLabel}" Width="75"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <Border x:Name="NoOrdersPanel" Style="{StaticResource EmptyState}" Visibility="Collapsed" Margin="0,12,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="لا توجد طلبات" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextAlignment="Center"/>
                                    <TextBlock Text="ستظهر الطلبات هنا عند وصولها من الموقع" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                               TextAlignment="Center" Margin="0,8,0,0"/>
                                    <Button Content="تحديث" Style="{StaticResource BtnOutline}" Click="RefreshOrders_Click" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Print queue -->
                        <StackPanel x:Name="PagePrintQueue" Visibility="Collapsed">
                            <TextBlock Text="جاري الطباعة" Style="{StaticResource SectionTitle}"/>
