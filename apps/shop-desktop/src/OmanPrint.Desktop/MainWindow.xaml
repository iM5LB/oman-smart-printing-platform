                                    <TextBlock x:Name="QueuePageCustomer" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock x:Name="QueuePageProgressPct" Text="0%" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left"/>
                                    </Grid>
                                    <ProgressBar x:Name="QueuePageProgress" Height="8" Minimum="0" Maximum="100" Value="0"
