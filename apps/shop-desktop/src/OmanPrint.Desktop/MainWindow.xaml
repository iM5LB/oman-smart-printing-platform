                                    <TextBlock Text="ربط بجهاز من لوحة المكتبة" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="بيانات المكتبة والموقع ورقم التأكيد تُدار من لوحة المكتبة على الويب. هنا فقط تربط هذا الجهاز برمز صادر من هناك."
                                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,12"/>
                                    <TextBlock Text="معرّف المكتبة" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="RegisterStoreSlug" Style="{StaticResource InputBox}" Margin="0,0,0,12"/>
