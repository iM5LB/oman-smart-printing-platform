                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Payments -->
                        <StackPanel x:Name="PagePayments" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
