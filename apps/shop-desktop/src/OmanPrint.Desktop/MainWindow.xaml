                            <!-- Total -->
                            <DockPanel Margin="0,0,0,18">
                                <TextBlock Text="السعر الإجمالي" FontSize="14" FontWeight="SemiBold" Foreground="#3B82F6" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DetailTotal" DockPanel.Dock="Left" FontSize="22" FontWeight="Bold"
                                           Foreground="#60A5FA" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Actions -->
                            <Button x:Name="DetailPrintBtn" Style="{StaticResource BtnPrimary}" Click="DetailPrint_Click" Margin="0,0,0,8" Padding="0,13">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="طباعة" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DetailRetryBtn" Style="{StaticResource BtnOutline}" Click="DetailRetry_Click" Margin="0,0,0,8" Padding="0,12" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="إعادة المحاولة" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DetailPayBtn" Style="{StaticResource BtnOutline}" Click="DetailPay_Click" Margin="0,0,0,8" Padding="0,12" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تحصيل الدفع" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DetailReadyBtn" Style="{StaticResource BtnSuccess}" Click="DetailReady_Click" Margin="0,0,0,8" Padding="0,13" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="جاهز للاستلام" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DetailCollectedBtn" Style="{StaticResource BtnOutline}" Click="DetailCollected_Click" Padding="0,12" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تم التسليم" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource StatusBar}">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusBarDot" Width="6" Height="6" Fill="{StaticResource ErrorBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnectionStatusBarText" Text="غير متصل" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="SyncFooterText" Text="آخر مزامنة: —" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Left" Text="الإصدار 1.0.0" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
