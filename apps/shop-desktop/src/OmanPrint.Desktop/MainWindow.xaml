                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Employees stub -->
                        <StackPanel x:Name="PageEmployees" Visibility="Collapsed">
                            <Border Style="{StaticResource EmptyState}" MaxWidth="480" HorizontalAlignment="Center" Margin="0,40,0,0">
