{
  "name": "@omsp/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "push": "dotenv -e ../../.env -- prisma db push",
    "db:push:prod": "prisma db push",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "seed:prod": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "build": "prisma generate && tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "prisma": "^6.5.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
